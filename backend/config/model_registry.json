{
  "models": [
    {
      "key": "neural-pytorch",
      "label": "Neural-BRDF / PyTorch",
      "category": "neural",
      "adapter": "neural-pytorch",
      "built_in": true,
      "description": "Neural-BRDF PyTorch 训练入口，输出 Mitsuba 可用的 .npy 权重。",
      "supports_training": true,
      "supports_extract": false,
      "supports_decode": false,
      "supports_runs": false,
      "supports_reconstruction": true,
      "model_dir": "models/Neural-BRDF",
      "requirements_path": "",
      "commands_doc": "",
      "render_modes": ["npy"],
      "parameters": [
        {"key": "epochs", "label": "训练轮数", "type": "int", "default": 100, "min": 1, "max": 100000},
        {"key": "device", "label": "训练设备", "type": "select", "default": "cpu", "options": ["cpu", "cuda"]}
      ],
      "default_paths": {
        "materials_dir": "data/inputs/binary",
        "output_dir": "data/inputs/npy"
      },
      "runtime": {
        "conda_env": "nbrdf-train",
        "working_dir": "models/Neural-BRDF/binary_to_nbrdf",
        "train_script": "models/Neural-BRDF/binary_to_nbrdf/pytorch_code/train_NBRDF_pytorch.py"
      },
      "operations": {
        "train": {
          "label": "训练",
          "description": "逐材质训练 PyTorch 模型，输出 .npy 权重",
          "script": "models/Neural-BRDF/binary_to_nbrdf/pytorch_code/train_NBRDF_pytorch.py",
          "loop_source": "request.selected_materials",
          "input_dir_source": "request.merl_dir",
          "args": [
            {"source": "item.path"},
            {"flag": "--outpath", "source": "request.output_dir"},
            {"flag": "--epochs", "source": "request.epochs", "default": 100},
            {"flag": "--device", "source": "request.device", "default": "cpu"}
          ]
        },
        "reconstruct": {
          "label": "重建",
          "description": "逐材质重建（同 train），输出 .npy 权重",
          "script": "models/Neural-BRDF/binary_to_nbrdf/pytorch_code/train_NBRDF_pytorch.py",
          "loop_source": "request.selected_materials",
          "input_dir_source": "request.merl_dir",
          "args": [
            {"source": "item.path"},
            {"flag": "--outpath", "source": "request.output_dir"},
            {"flag": "--epochs", "source": "request.neural_epochs", "default": 100},
            {"flag": "--device", "source": "request.neural_device", "default": "cpu"}
          ]
        }
      }
    },
    {
      "key": "neural-keras",
      "label": "Neural-BRDF / Keras",
      "category": "neural",
      "adapter": "neural-keras",
      "built_in": true,
      "description": "Neural-BRDF Keras 训练入口，先输出 .h5/.json，再转换为 .npy。",
      "supports_training": true,
      "supports_extract": false,
      "supports_decode": false,
      "supports_runs": false,
      "supports_reconstruction": true,
      "model_dir": "models/Neural-BRDF",
      "requirements_path": "",
      "commands_doc": "",
      "render_modes": ["npy"],
      "parameters": [
        {"key": "cuda_device", "label": "CUDA 设备", "type": "str", "default": "0"}
      ],
      "default_paths": {
        "materials_dir": "data/inputs/binary",
        "h5_output_dir": "models/Neural-BRDF/data/merl_nbrdf",
        "npy_output_dir": "data/inputs/npy"
      },
      "runtime": {
        "conda_env": "nbrdf-train",
        "working_dir": "models/Neural-BRDF/binary_to_nbrdf",
        "train_script": "models/Neural-BRDF/binary_to_nbrdf/binary_to_nbrdf.py",
        "convert_script": "models/Neural-BRDF/binary_to_nbrdf/h5_to_npy.py"
      },
      "operations": {
        "train": {
          "label": "训练",
          "description": "批量训练 Keras 模型，合并材质为位置参数",
          "script": "models/Neural-BRDF/binary_to_nbrdf/binary_to_nbrdf.py",
          "loop_source": "request.selected_materials",
          "input_dir_source": "request.merl_dir",
          "merge_inputs": true,
          "args": [
            {"source": "item.path"},
            {"flag": "--cuda_device", "source": "request.cuda_device", "default": "0"}
          ],
          "post_actions": [
            {
              "type": "move_files",
              "description": "归档 h5/json/lossplot 到 h5_output_dir",
              "patterns": ["*.h5", "*.json", "lossplot_*.png"],
              "source_dir_source": "cwd",
              "dest_dir_source": "request.h5_output_dir"
            }
          ]
        },
        "convert": {
          "label": "H5→NPY 转换",
          "description": "批量将 .h5 文件转换为 .npy",
          "script": "models/Neural-BRDF/binary_to_nbrdf/h5_to_npy.py",
          "loop_source": "request.selected_h5_files",
          "input_dir_source": "request.h5_dir",
          "merge_inputs": true,
          "args": [
            {"source": "item.path"},
            {"flag": "--destdir", "source": "request.npy_output_dir"}
          ]
        }
      }
    },
    {
      "key": "hyperbrdf",
      "label": "HyperBRDF",
      "category": "hyper",
      "adapter": "hyper-family",
      "built_in": true,
      "description": "HyperBRDF 基线模型，支持训练、参数提取和 .fullbin 解码。",
      "supports_training": true,
      "supports_extract": true,
      "supports_decode": true,
      "supports_runs": true,
      "supports_reconstruction": true,
      "model_dir": "models/HyperBRDF",
      "requirements_path": "",
      "commands_doc": "",
      "render_modes": ["fullbin"],
      "parameters": [
        {"key": "epochs", "label": "训练轮数", "type": "int", "default": 100, "min": 1, "max": 100000},
        {"key": "sparse_samples", "label": "稀疏采样点数", "type": "int", "default": 4000, "min": 1, "max": 1000000},
        {"key": "kl_weight", "label": "KL 权重", "type": "float", "default": 0.1, "min": 0, "max": 100},
        {"key": "fw_weight", "label": "FW 权重", "type": "float", "default": 0.1, "min": 0, "max": 100},
        {"key": "lr", "label": "学习率", "type": "float", "default": 0.00005, "min": 0, "max": 1},
        {"key": "train_subset", "label": "训练材质数", "type": "int", "default": 80, "min": 0, "max": 100},
        {"key": "train_seed", "label": "随机种子", "type": "int", "default": 42, "min": 0, "max": 999999},
        {"key": "keepon", "label": "继续训练", "type": "bool", "default": false}
      ],
      "default_paths": {
        "materials_dir": "data/inputs/binary",
        "results_dir": "models/HyperBRDF/results",
        "extract_dir": "models/HyperBRDF/results/extracted_pts",
        "checkpoint": "models/HyperBRDF/results/test/MERL/checkpoint.pt"
      },
      "runtime": {
        "conda_env": "hyperbrdf",
        "working_dir": "models/HyperBRDF",
        "train_script": "models/HyperBRDF/main.py",
        "extract_script": "models/HyperBRDF/test.py",
        "decode_script": "models/HyperBRDF/pt_to_fullmerl.py"
      },
      "operations": {
        "train": {
          "label": "训练",
          "description": "在 MERL 数据集上训练 HyperBRDF 模型",
          "script": "models/HyperBRDF/main.py",
          "args": [
            {"flag": "--destdir", "source": "request.output_dir"},
            {"flag": "--binary", "source": "request.merl_dir"},
            {"flag": "--dataset", "source": "request.dataset", "default": "MERL"},
            {"flag": "--epochs", "source": "request.epochs", "default": 100},
            {"flag": "--sparse_samples", "source": "request.sparse_samples", "default": 4000},
            {"flag": "--kl_weight", "source": "request.kl_weight", "default": 0.1},
            {"flag": "--fw_weight", "source": "request.fw_weight", "default": 0.1},
            {"flag": "--lr", "source": "request.lr", "default": 5e-5},
            {"flag": "--train_subset", "source": "request.train_subset", "default": 0},
            {"flag": "--train_seed", "source": "request.train_seed", "default": 42},
            {"flag": "--keepon", "condition_source": "request.keepon"}
          ]
        },
        "extract": {
          "label": "参数提取",
          "description": "从训练好的 checkpoint 提取材质参数为 .pt 文件",
          "script": "models/HyperBRDF/test.py",
          "loop_source": "request.selected_materials",
          "input_dir_source": "request.merl_dir",
          "args": [
            {"flag": "--model", "source": "request.checkpoint_path"},
            {"flag": "--binary", "source": "item.path"},
            {"flag": "--destdir", "source": "request.output_dir"},
            {"flag": "--dataset", "source": "request.dataset", "default": "MERL"},
            {"flag": "--sparse_samples", "source": "request.sparse_samples", "default": 4000}
          ]
        },
        "decode": {
          "label": "FullBin 解码",
          "description": "将 .pt 文件解码为 Mitsuba 可用的 .fullbin",
          "script": "models/HyperBRDF/pt_to_fullmerl.py",
          "loop_source": "request.selected_pts",
          "input_dir_source": "request.pt_dir",
          "args": [
            {"source": "item.path"},
            {"source": "request.output_dir"},
            {"flag": "--dataset", "source": "request.dataset", "default": "MERL"},
            {"flag": "--cuda_device", "source": "request.cuda_device", "default": "0"}
          ]
        },
        "reconstruct": {
          "label": "重建",
          "description": "Extract → Decode 两阶段重建（从 checkpoint 到 .fullbin）",
          "sub_operations": ["extract", "decode"],
          "output_transform_type": "selected_materials_to_pt"
        }
      }
    },
    {
      "key": "hypersnbrdf",
      "label": "HyperSNBRDF",
      "category": "hyper",
      "adapter": "hypersnbrdf",
      "built_in": true,
      "description": "HyperNetwork + SIREN 神经 BRDF 表示模型，从 MERL BRDF 数据集学习材质反射特性，支持训练和评估渲染。",
      "supports_training": true,
      "supports_extract": false,
      "supports_decode": false,
      "supports_runs": false,
      "supports_reconstruction": false,
      "model_dir": "models/HyperSNBRDF",
      "requirements_path": "models/HyperSNBRDF/requirements.txt",
      "commands_doc": "",
      "render_modes": [],
      "parameters": [
        {"key": "epochs", "label": "训练轮数", "type": "int", "default": 10000, "min": 1, "max": 100000},
        {"key": "lr", "label": "学习率", "type": "float", "default": 0.00001, "min": 0, "max": 1},
        {"key": "siren_hid_features", "label": "SIREN 隐藏层特征数", "type": "int", "default": 21, "min": 1, "max": 256},
        {"key": "train_sample_num", "label": "SetEncoder 采样数", "type": "int", "default": 400000, "min": 1, "max": 5000000},
        {"key": "siren_sample_num", "label": "SIREN 采样数", "type": "int", "default": 400000, "min": 1, "max": 5000000},
        {"key": "tonemap_num", "label": "Tone Mapping 参数", "type": "int", "default": 1, "min": 1, "max": 10},
        {"key": "k1", "label": "MAE 权重 (k1)", "type": "float", "default": 1.0, "min": 0, "max": 100},
        {"key": "kl", "label": "Latent 正则权重 (kl)", "type": "float", "default": 0.01, "min": 0, "max": 100},
        {"key": "kw", "label": "Weight 正则权重 (kw)", "type": "float", "default": 0.1, "min": 0, "max": 100},
        {"key": "seed", "label": "随机种子", "type": "int", "default": 1234794195, "min": 0, "max": 2147483647}
      ],
      "default_paths": {
        "train_materials_dir": "data/merl_train_78",
        "test_materials_dir": "data/merl_test_22",
        "test_angles_dir": "data/test_th_td_pd2pi",
        "test_li_cam_dir": "data/test_li_cam",
        "output_dir": "models/HyperSNBRDF/../output"
      },
      "runtime": {
        "conda_env": "hypersnbrdf",
        "working_dir": "models/HyperSNBRDF",
        "train_script": "models/HyperSNBRDF/main.py",
        "eval_script": "models/HyperSNBRDF/eval_h21l5.py"
      },
      "operations": {
        "train": {
          "label": "训练",
          "description": "在 MERL 数据集上训练 HyperSNBRDF 模型",
          "script": "models/HyperSNBRDF/main.py",
          "args": [
            {"flag": "--epochs", "source": "request.epochs", "default": 10000},
            {"flag": "--lr", "source": "request.lr", "default": 1e-5},
            {"flag": "--siren_hid_features", "source": "request.siren_hid_features", "default": 21},
            {"flag": "--train_sample_num", "source": "request.train_sample_num", "default": 400000},
            {"flag": "--siren_sample_num", "source": "request.siren_sample_num", "default": 400000},
            {"flag": "--tonemap_num", "source": "request.tonemap_num", "default": 1},
            {"flag": "--k1", "source": "request.k1", "default": 1.0},
            {"flag": "--kl", "source": "request.kl", "default": 0.01},
            {"flag": "--kw", "source": "request.kw", "default": 0.1},
            {"flag": "--seed", "source": "request.seed", "default": 1234794195}
          ]
        },
        "eval": {
          "label": "评估",
          "description": "评估训练好的 HyperSNBRDF 模型",
          "script": "models/HyperSNBRDF/eval_h21l5.py",
          "args": [
            {"flag": "--model_path", "source": "request.checkpoint_path"}
          ]
        }
      }
    }
  ]
}
